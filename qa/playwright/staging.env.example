STAGING_BASE_URL=https://staging.example.com
STAGING_QA_SECRET=<protected-random-staging-qa-secret>
QA_RUN_ID=manual-certification
STAGING_QA_CUSTOMER_EMAIL=acceptance+customer@example.com
STAGING_QA_ADMIN_EMAIL=acceptance+admin@example.com
STAGING_QA_RESTRICTED_EMAIL=acceptance+rights@example.com
STAGING_QA_UNAUTHORIZED_EMAIL=acceptance+viewer@example.com
STAGING_QA_FINANCE_EMAIL=acceptance+finance@example.com
STAGING_QA_REPORT_VIEWER_EMAIL=acceptance+report-viewer@example.com
RELEASE_SHA=<exact-40-char-staging-sha>
ALLOW_MOCK_PAYMENTS=true
JALWA_EXPECT_LIVE_SOURCES=false

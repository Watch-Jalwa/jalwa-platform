# Non-secret template only. Never commit real staging credentials.
STAGING_BASE_URL=https://staging.example.com
STAGING_SUPABASE_URL=https://api.staging.example.com
STAGING_SUPABASE_ANON_KEY=<protected-staging-anon-key>
STAGING_SUPABASE_SERVICE_ROLE_KEY=<protected-staging-service-role-key>
RELEASE_SHA=<exact-40-character-deployed-git-sha>

STAGING_QA_CUSTOMER_EMAIL=<synthetic-customer-email>
STAGING_QA_ADMIN_EMAIL=<synthetic-admin-email>
STAGING_QA_RESTRICTED_EMAIL=<synthetic-rights-reviewer-email>
STAGING_QA_UNAUTHORIZED_EMAIL=<synthetic-viewer-email>
STAGING_QA_FINANCE_EMAIL=<synthetic-finance-email>
STAGING_QA_REPORT_VIEWER_EMAIL=<synthetic-non-finance-report-viewer-email>

ALLOW_MOCK_PAYMENTS=true
JALWA_EXPECT_LIVE_SOURCES=false
# VISUAL_BASELINE_MANIFEST=qa/visual-baselines/manifest.json

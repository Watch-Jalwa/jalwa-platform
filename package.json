{
  "name": "jalwa-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=22.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace @jalwa/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ai": "node --test apps/web/tests/ai-provider.test.mjs apps/web/tests/ai-readiness.test.mjs apps/web/tests/ai-request.test.mjs",
    "test:release": "bash scripts/test-production-release.sh",
    "test:container": "bash scripts/test-production-container.sh",
    "test:backup-encryption": "bash scripts/test-backup-encryption.sh",
    "harvest:alpha": "node scripts/harvest-alpha-open-content.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:release && npm run test:backup-encryption && npm run build"
  }
}

# Optional media backend override loaded after .env.production.
# Keep this file absent to use values from the main runtime environment.
MEDIA_BACKEND=r2
TRANSCODE_BACKEND=ffmpeg
MEDIA_PLAYBACK_TTL_SECONDS=300
SOURCE_DOWNLOAD_MAX_BYTES=1073741824
SOURCE_DOWNLOAD_MAX_REDIRECTS=3

# AWS mode — populated by the protected Set media backend workflow.
AWS_REGION=
AWS_MEDIA_CONTROL_URL=
AWS_MEDIA_CONTROL_SECRET=
AWS_MEDIA_CDN_URL=
AWS_MEDIA_INCOMING_BUCKET=
AWS_MEDIA_PROCESSED_BUCKET=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=
CLOUDFRONT_COOKIE_DOMAIN=

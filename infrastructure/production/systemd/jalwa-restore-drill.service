[Unit]
Description=Verify Jalwa PostgreSQL backup restoration
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=jalwa
Group=jalwa
EnvironmentFile=/opt/jalwa/.env.production
ExecStart=/opt/jalwa/scripts/restore-drill.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

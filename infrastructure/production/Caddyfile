    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    X-Frame-Options "SAMEORIGIN"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://media.{$DOMAIN} https://*.cloudflarestream.com; media-src 'self' blob: https://media.{$DOMAIN} https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://*.cloudflarestream.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; report-uri /api/security/csp-report"
    Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://media.{$DOMAIN} https://*.cloudflarestream.com; media-src 'self' blob: https://media.{$DOMAIN} https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://*.cloudflarestream.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; report-uri /api/security/csp-report"
    -Server
  }

  reverse_proxy web:3000


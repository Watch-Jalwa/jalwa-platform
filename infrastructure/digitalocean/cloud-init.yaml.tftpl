#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - fail2ban
  - postgresql-client
  - unattended-upgrades

users:
  - name: jalwa
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/99-jalwa.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      PubkeyAuthentication yes
  - path: /etc/fail2ban/jail.d/jalwa.local
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
  - path: /opt/jalwa/HOST_INFO
    permissions: "0644"
    content: |
      domain=${domain}
      provisioned_by=terraform

runcmd:
  - systemctl enable --now docker
  - systemctl enable --now fail2ban
  - mkdir -p /opt/jalwa/backups
  - chown -R jalwa:jalwa /opt/jalwa
  - chmod 750 /opt/jalwa
  - systemctl restart ssh
